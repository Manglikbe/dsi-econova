# Dépôts APT de LNX01 (Debian 13 "trixie"), modifiés pour l'installation
# des paquets pendant l'ouverture temporaire de l'accès Internet.
# La ligne cdrom d'origine est commentée.
# deb cdrom:[Debian GNU/Linux 13.7.0 _Trixie_ - Official amd64 NETINST with firmware]/ trixie contrib main non-free-firmware

deb http://deb.debian.org/debian trixie main contrib non-free-firmware
deb http://deb.debian.org/debian trixie-updates main contrib non-free-firmware
deb http://security.debian.org/debian-security trixie-security main contrib non-free-firmware
